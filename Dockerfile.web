# GuardSaaB Web Frontends Container (Dashboard :5174 / Company :5173)
FROM node:22-alpine

WORKDIR /app

RUN apk add --no-cache curl bash

# Copy root and dashboard package files
COPY package*.json tsconfig.json ./
COPY dashboard/package*.json ./dashboard/

# Install root dependencies and dashboard dependencies
RUN npm install
RUN npm --prefix dashboard install

# Copy source code
COPY src ./src
COPY dashboard ./dashboard

# Default environment configuration
ENV VITE_HOST=0.0.0.0
ENV VITE_ENGINE_URL=http://engine:9000
ENV VITE_WS_URL=ws://engine:9000/ws
ENV PORT=5174

COPY scripts/docker-web-entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

EXPOSE 5173 5174

HEALTHCHECK --interval=4s --timeout=3s --start-period=5s --retries=15 \
  CMD curl -fsS http://127.0.0.1:${PORT}/ || exit 1

ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["npm", "--prefix", "dashboard", "run", "dev:guardsaab"]
