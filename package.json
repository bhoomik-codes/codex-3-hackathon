{
  "name": "@guardsaab/core",
  "version": "0.1.0",
  "description": "GuardSaaB (Software as a Blockade) — local-first control plane for autonomous AI agents.",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "author": "bhoomik-codes",
  "homepage": "https://github.com/bhoomik-codes/codex-3-hackathon#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhoomik-codes/codex-3-hackathon.git"
  },
  "bugs": {
    "url": "https://github.com/bhoomik-codes/codex-3-hackathon/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "security",
    "guardrail",
    "claude-code",
    "llm",
    "waf",
    "prompt-injection",
    "human-in-the-loop",
    "mcp"
  ],
  "bin": {
    "guardsaab": "bin/guardsaab.mjs"
  },
  "files": [
    "dist",
    "dashboard/dist",
    "rules",
    "examples",
    "bin",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "demo": "tsx scripts/start-demo.ts",
    "showcase": "tsx src/cli/index.ts showcase",
    "console": "tsx src/cli/index.ts console",
    "monitor": "tsx src/cli/index.ts monitor",
    "eval": "tsx src/cli/index.ts eval",
    "engine": "tsx src/cli/index.ts engine",
    "engine:local": "tsx src/cli/index.ts engine --local-db",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose stop postgres",
    "dev:company": "npm --prefix dashboard run dev:company",
    "dev:guardsaab": "npm --prefix dashboard run dev:guardsaab",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "hook": "tsx src/cli/index.ts hook",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:engine && npm run build:dashboard",
    "build:engine": "tsc",
    "build:dashboard": "npm --prefix dashboard run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build",
    "test:behavioral": "tsx scripts/behavioral.test.ts",
    "e2e:behavioral": "node scripts/behavioral-e2e.mjs",
    "test:content": "tsx scripts/content.test.ts",
    "e2e:content": "node scripts/content-e2e.mjs",
    "test:injection": "tsx scripts/injection.test.ts",
    "e2e:injection": "node scripts/injection-e2e.mjs",
    "test:bypass": "tsx scripts/bypass.test.ts",
    "test:fp": "tsx scripts/fp.test.ts",
    "test:hook": "tsx scripts/hook.test.ts",
    "test:store": "tsx scripts/store.test.ts",
    "test:mcp-scan": "tsx scripts/mcp-scan.test.ts",
    "test:proxy": "tsx scripts/proxy.test.ts",
    "test:mitm": "tsx scripts/mitm.test.ts",
    "test:deps": "tsx scripts/deps.test.ts",
    "test:ioc": "tsx scripts/ioc.test.ts",
    "e2e:ioc": "node scripts/ioc-e2e.mjs",
    "e2e:attack": "node scripts/attack-sim.mjs",
    "e2e:redteam": "node scripts/redteam-run.mjs",
    "e2e:malware": "node scripts/malware-sim.mjs",
    "test:risk": "tsx scripts/risk.test.ts",
    "e2e:risk": "node scripts/risk-e2e.mjs",
    "test:init": "tsx scripts/init.test.ts",
    "test:projector": "tsx scripts/projector.test.ts",
    "test:audit": "tsx scripts/audit.test.ts",
    "test:notify": "tsx scripts/notify.test.ts",
    "test:security": "tsx scripts/security.test.ts",
    "test:policy": "tsx scripts/policy.test.ts",
    "test:policy-validation": "tsx scripts/validate-policy.test.ts",
    "test:audit-sanitize": "tsx scripts/audit-sanitize.test.ts",
    "test:postgres-audit": "tsx scripts/postgres-audit.test.ts",
    "test:regression": "tsx scripts/regression.test.ts",
    "test:adapters": "tsx scripts/adapters.test.ts",
    "test:validate": "tsx scripts/validate.test.ts"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "json-logic-js": "^2.0.5",
    "pg": "^8.23.1",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "node-forge": "^1.4.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "@types/node-forge": "^1.3.14",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
